datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 4.1 Users
model User {
  id                 String             @id @default(uuid())
  username           String             @unique
  email              String?            @unique
  phone              String?
  password_hash      String
  full_name          String
  role_id            String
  role               Role               @relation(fields: [role_id], references: [id])
  organization_id    String
  organization       Organization       @relation(fields: [organization_id], references: [id])
  patient_profile_id String?            // If the user is a patient
  is_active          Boolean            @default(true)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  deleted_at         DateTime?

  permissions        UserPermission[]
  clinician_appointments Appointment[]
  requested_changes      OrganizationChangeRequest[]
  reviewed_changes       OrganizationChangeRequest[] @relation("Reviewer")
}

// 4.2 Organizations
model Organization {
  id                     String         @id @default(uuid())
  organization_name      String
  organization_name_ar   String?
  organization_type      String         // e.g., 'MOH', 'HOSPITAL', 'CLINIC'
  region                 String?
  status                 String         @default("ACTIVE")
  parent_organization_id String?
  parent                 Organization?  @relation("OrgHierarchy", fields: [parent_organization_id], references: [id])
  children               Organization[] @relation("OrgHierarchy")
  created_at             DateTime       @default(now())

  users                  User[]
  patients               PatientOrganization[]
  encounters             Encounter[]
  conditions             Condition[]
  observations           Observation[]
  medication_requests    MedicationRequest[]
  immunizations          Immunization[]
  coverages              Coverage[]
  claims                 Claim[]
  consents               Consent[]
  audit_logs             AuditLog[]
  data_imports           DataImport[]
  appointments           Appointment[]
  change_requests        OrganizationChangeRequest[]
}

enum RoleCode {
  SYS_ADMIN
  MOH_ADMIN
  MOH_AUDITOR
  HOSPITAL_ADMIN
  CLINICIAN
  PATIENT
}

enum PermissionCode {
  ORG_MANAGE_ALL
  ORG_APPROVE
  POLICY_MANAGE
  QUALITY_MONITOR
  AUDIT_READ_CENTRAL
  AUDIT_READ_ORG
  ANALYTICS_READ_NATIONAL
  ANALYTICS_READ_ORG
  USER_MANAGE_NATIONAL
  USER_MANAGE_ORG
  ROLE_ASSIGN_NATIONAL
  ROLE_ASSIGN_ORG
  PATIENT_READ_SELF
  PATIENT_READ_ORG
  PATIENT_READ_ALL
  PATIENT_MANAGE_ORG
  ENCOUNTER_CREATE_ORG
  CLINICAL_WRITE_ORG
  CLINICAL_READ_ORG
  CLINICAL_READ_ALL
  CLAIM_MANAGE_ORG
  IMPORT_EXECUTE_ORG
  CONSENT_MANAGE_SELF
  CONSENT_OVERRIDE
  BREAK_GLASS_EXECUTE
  EXPORT_BULK_ANONYMIZED
  EXPORT_BULK_IDENTIFIED
  FHIR_READ_SELF
  FHIR_READ_ORG
  FHIR_READ_ALL
  ACCESS_HISTORY_READ_SELF
}

// 4.3 Roles
model Role {
  id             String           @id @default(uuid())
  role_name      String
  role_code      RoleCode         @unique
  description    String?
  is_system_role Boolean          @default(false)
  users          User[]
  permissions    RolePermission[]
}

// 4.4 RolePermissions
model RolePermission {
  id              String         @id @default(uuid())
  role_id         String
  role            Role           @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission_code PermissionCode
  granted         Boolean        @default(true)
  created_at      DateTime       @default(now())

  @@unique([role_id, permission_code])
}

// 4.5 UserPermissions
model UserPermission {
  id              String         @id @default(uuid())
  user_id         String
  user            User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permission_code PermissionCode
  granted         Boolean        @default(true)
  created_at      DateTime @default(now())
}

// 4.6 Patients (Canonical)
model Patient {
  id                    String                @id @default(uuid())
  internal_id           String                @unique
  internal_id_uuid String?  @unique // P6 opaque UUID
  first_name            String?
  last_name             String?
  first_name_ar         String?
  last_name_ar          String?
  birth_date            DateTime?
  gender                String?
  phone                 String?
  email                 String?
  status                String                @default("ACTIVE")
  
  // Provenance fields
  source_system_id      String?
  source_record_id      String?

  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt

  identifiers           PatientIdentifier[]
  organizations         PatientOrganization[]
  encounters            Encounter[]
  conditions            Condition[]
  observations          Observation[]
  medication_requests   MedicationRequest[]
  immunizations         Immunization[]
  coverages             Coverage[]
  claims                Claim[]
  consents              Consent[]
  appointments          Appointment[]
  allergies             AllergyIntolerance[]
  diagnostic_reports    DiagnosticReport[]
  
  // Patient-reported health data
  patient_profile       PatientProfile?
  reported_allergies    PatientReportedAllergy[]
  reported_medications  PatientReportedMedication[]
  reported_conditions   PatientReportedCondition[]
  reported_procedures   PatientReportedProcedure[]
  family_members        FamilyMember[]
  social_history        PatientReportedSocialHistory?
  vital_observations    PatientReportedVitalObservation[]
  uploaded_documents    PatientUploadedDocument[]

  @@index([phone])
  @@index([created_at])
  @@index([first_name])
  @@index([first_name_ar])
}

// Patient Identifiers (NID, Iqama, MRN)
model PatientIdentifier {
  id                String   @id @default(uuid())
  patient_id        String
  patient           Patient  @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  value             String
  type              String   // NID, IQAMA, MRN
  system            String?
  source_system_id  String?
  is_active         Boolean  @default(true)
  first_seen_at     DateTime @default(now())

  @@index([value])
  @@index([patient_id, is_active])
}

// 4.7 PatientOrganizations
model PatientOrganization {
  id                String       @id @default(uuid())
  patient_id        String
  patient           Patient      @relation(fields: [patient_id], references: [id])
  organization_id   String
  organization      Organization @relation(fields: [organization_id], references: [id])
  relationship_type String       // e.g., 'PRIMARY_CARE', 'TREATED'
  assigned_at       DateTime     @default(now())
  active            Boolean      @default(true)

  @@index([organization_id, active])
  @@index([patient_id])
}

// 4.8 Encounters
model Encounter {
  id               String       @id @default(uuid())
  internal_id      String       @unique
  patient_id       String
  patient          Patient      @relation(fields: [patient_id], references: [internal_id])
  patient_id_uuid  String?
  // TODO P6: migrate FK to Patient.id, keep patient_id for backward compat
  organization_id  String?
  organization     Organization? @relation(fields: [organization_id], references: [id])
  
  source_visit_id  String?
  encounter_class  String?      // AMB, IMP, EMR
  status           String       @default("FINISHED")
  period_start     DateTime?
  period_end       DateTime?
  
  source_system_id String?
  source_record_id String?
  
  created_at       DateTime     @default(now())
  correction_status String      @default("ACTIVE")
  correction_reason String?
  corrected_by     String?
  corrected_at     DateTime?
  superseded_by    String?

  conditions       Condition[]
  observations     Observation[]
  medication_requests MedicationRequest[]
  diagnostic_reports DiagnosticReport[]
  claims           Claim[]
  immunizations    Immunization[]
}

// 4.9 Conditions
model Condition {
  id               String       @id @default(uuid())
  internal_id      String       @unique
  patient_id       String
  patient          Patient      @relation(fields: [patient_id], references: [internal_id])
  patient_id_uuid  String?
  // TODO P6: migrate FK to Patient.id, keep patient_id for backward compat
  encounter_id     String?
  encounter        Encounter?   @relation(fields: [encounter_id], references: [internal_id])
  organization_id  String?
  organization     Organization? @relation(fields: [organization_id], references: [id])
  
  clinical_status  String?
  verification_status String?
  
  // ClinicalCode fields mapped
  code_source_code String?
  code_source_system String?
  code_source_display String?
  code_snomed_code String?
  code_snomed_display String?
  code_icd10am_code String?
  code_icd10am_display String?

  recorded_date    DateTime?
  
  source_system_id String?
  source_record_id String?
  
  created_at       DateTime     @default(now())
  correction_status String      @default("ACTIVE")
  correction_reason String?
  corrected_by     String?
  corrected_at     DateTime?
}

// 4.10 Observations
model Observation {
  id               String       @id @default(uuid())
  internal_id      String       @unique
  patient_id       String
  patient          Patient      @relation(fields: [patient_id], references: [internal_id])
  patient_id_uuid  String?
  // TODO P6: migrate FK to Patient.id, keep patient_id for backward compat
  encounter_id     String?
  encounter        Encounter?   @relation(fields: [encounter_id], references: [internal_id])
  organization_id  String?
  organization     Organization? @relation(fields: [organization_id], references: [id])
  
  status           String?
  
  code_source_code String?
  code_source_system String?
  code_source_display String?
  code_loinc_code  String?
  code_loinc_display String?
  code_sbs_code    String?
  code_sbs_display String?
  
  value_quantity   Float?
  value_unit       String?
  value_string     String?
  
  effective_date   DateTime?
  
  source_system_id String?
  source_record_id String?
  
  created_at       DateTime     @default(now())
  correction_status String      @default("ACTIVE")
  correction_reason String?
  corrected_by     String?
  corrected_at     DateTime?
}

// 4.11 MedicationRequests
model MedicationRequest {
  id               String       @id @default(uuid())
  internal_id      String       @unique
  patient_id       String
  patient          Patient      @relation(fields: [patient_id], references: [internal_id])
  patient_id_uuid  String?
  // TODO P6: migrate FK to Patient.id, keep patient_id for backward compat
  encounter_id     String?
  encounter        Encounter?   @relation(fields: [encounter_id], references: [internal_id])
  organization_id  String?
  organization     Organization? @relation(fields: [organization_id], references: [id])
  
  status           String?
  intent           String?
  
  code_source_code String?
  code_source_system String?
  code_source_display String?
  code_sfda_code   String?
  code_sfda_display String?
  code_rxnorm_code String?
  code_rxnorm_display String?
  code_atc_code    String?
  
  dosage_text      String?
  authored_on      DateTime?
  
  source_system_id String?
  source_record_id String?
  
  created_at       DateTime     @default(now())
  correction_status String      @default("ACTIVE")
  correction_reason String?
  corrected_by     String?
  corrected_at     DateTime?
}

// 4.12 Immunizations
model Immunization {
  id               String       @id @default(uuid())
  internal_id      String       @unique
  patient_id       String
  patient          Patient      @relation(fields: [patient_id], references: [internal_id])
  patient_id_uuid  String?
  // TODO P6: migrate FK to Patient.id, keep patient_id for backward compat
  encounter_id     String?
  encounter        Encounter?   @relation(fields: [encounter_id], references: [internal_id])
  organization_id  String?
  organization     Organization? @relation(fields: [organization_id], references: [id])
  
  status           String?
  
  code_source_code String?
  code_source_system String?
  code_source_display String?
  code_cvx_code    String?
  code_cvx_display String?
  
  occurrence_date  DateTime?
  
  source_system_id String?
  source_record_id String?
  
  created_at       DateTime     @default(now())
}

// 4.13 Coverages
model Coverage {
  id               String       @id @default(uuid())
  internal_id      String       @unique
  patient_id       String
  patient          Patient      @relation(fields: [patient_id], references: [internal_id])
  patient_id_uuid  String?
  // TODO P6: migrate FK to Patient.id, keep patient_id for backward compat
  organization_id  String?
  organization     Organization? @relation(fields: [organization_id], references: [id])
  
  status           String?
  type             String?
  subscriber_id    String?
  beneficiary_id   String?
  payor_id         String?
  
  period_start     DateTime?
  period_end       DateTime?
  
  source_system_id String?
  source_record_id String?
  
  created_at       DateTime     @default(now())

  claims           Claim[]
}

// 4.14 Claims
model Claim {
  id               String       @id @default(uuid())
  internal_id      String       @unique
  patient_id       String
  patient          Patient      @relation(fields: [patient_id], references: [internal_id])
  patient_id_uuid  String?
  // TODO P6: migrate FK to Patient.id, keep patient_id for backward compat
  organization_id  String?
  organization     Organization? @relation(fields: [organization_id], references: [id])
  encounter_id     String?
  encounter        Encounter?   @relation(fields: [encounter_id], references: [internal_id])
  coverage_id      String?
  coverage         Coverage?    @relation(fields: [coverage_id], references: [internal_id])
  
  status           String?
  type             String?
  use              String?
  
  total_value      Float?
  total_currency   String?
  
  submission_date  DateTime?
  
  source_system_id String?
  source_record_id String?
  
  created_at       DateTime     @default(now())

  claim_responses  ClaimResponse[]
}

// ClaimResponse
model ClaimResponse {
  id               String       @id @default(uuid())
  claim_id         String
  claim            Claim        @relation(fields: [claim_id], references: [internal_id])
  
  status           String?
  outcome          String?
  
  payment_value    Float?
  payment_currency String?
  
  created_at       DateTime     @default(now())
}

// AllergyIntolerance
model AllergyIntolerance {
  id               String       @id @default(uuid())
  internal_id      String       @unique
  patient_id       String
  patient          Patient      @relation(fields: [patient_id], references: [internal_id])
  patient_id_uuid  String?
  // TODO P6: migrate FK to Patient.id, keep patient_id for backward compat
  
  clinical_status  String?
  verification_status String?
  type             String?
  
  code_source_code String?
  code_source_system String?
  code_source_display String?
  code_snomed_code String?
  code_snomed_display String?
  
  recorded_date    DateTime?
  
  source_system_id String?
  source_record_id String?
  
  created_at       DateTime     @default(now())
}

// DiagnosticReport
model DiagnosticReport {
  id               String       @id @default(uuid())
  internal_id      String       @unique
  patient_id       String
  patient          Patient      @relation(fields: [patient_id], references: [internal_id])
  patient_id_uuid  String?
  // TODO P6: migrate FK to Patient.id, keep patient_id for backward compat
  encounter_id     String?
  encounter        Encounter?   @relation(fields: [encounter_id], references: [internal_id])
  
  status           String?
  
  code_source_code String?
  code_source_system String?
  code_source_display String?
  code_loinc_code  String?
  code_loinc_display String?
  
  issued           DateTime?
  
  source_system_id String?
  source_record_id String?
  
  created_at       DateTime     @default(now())
}

// 4.15 Consents - Quad Appointment+Consent Model
model Consent {
  id               String       @id @default(uuid())
  patient_id       String
  patient          Patient      @relation(fields: [patient_id], references: [internal_id])
  patient_id_uuid  String?
  // TODO P6: migrate FK to Patient.id, keep patient_id for backward compat
  organization_id  String?
  organization     Organization? @relation(fields: [organization_id], references: [id])
  appointment_id   String?      @unique
  appointment      Appointment? @relation(fields: [appointment_id], references: [id])
  consent_type     String
  granted          Boolean      @default(true)
  granted_at       DateTime     @default(now())
  revoked_at       DateTime?
  expires_at       DateTime?
  scope            String
  allowed_organizations String?
  blocked_categories String?
  consent_source   String
  created_by       String?
}

// 4.15b Appointments - Quad Model (ROUTINE/EMERGENCY/REFERRAL/CHRONIC)
model Appointment {
  id               String       @id @default(uuid())
  patient_id       String
  patient          Patient      @relation(fields: [patient_id], references: [internal_id])
  patient_id_uuid  String?
  // TODO P6: migrate FK to Patient.id, keep patient_id for backward compat
  organization_id  String
  organization     Organization @relation(fields: [organization_id], references: [id])
  clinician_id     String?
  clinician        User?        @relation(fields: [clinician_id], references: [id])
  appointment_type String       // ROUTINE, EMERGENCY, REFERRAL, CHRONIC
  status           String       @default("proposed") // proposed, booked, arrived, fulfilled, cancelled, no_show
  service_category String?
  scheduled_start  DateTime
  scheduled_end    DateTime?
  reason           String?
  slot_id          String?
  created_by       String
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  consent          Consent?

  @@index([patient_id])
  @@index([organization_id])
  @@index([clinician_id])
  @@index([status])
}

// 4.16 AuditLogs
model AuditLog {
  id               String       @id @default(uuid())
  entity_type      String
  entity_id        String
  action           String
  
  actor_id         String?
  organization_id  String?
  organization     Organization? @relation(fields: [organization_id], references: [id])

  old_values       String?      // JSON string
  new_values       String?      // JSON string
  ip_address       String?
  
  details          String?
  
  created_at       DateTime     @default(now())
}

// 4.16b AuditChain Blocks — separated from AuditLog to prevent pollution (P8)
model AuditBlock {
  id            String   @id // blockId (uuid)
  index         Int      @unique
  timestamp     DateTime @default(now())
  action        String
  actor         String
  entityType    String
  entityId      String
  details       String
  previousHash  String
  currentHash   String
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

// 4.17 DataImports
model DataImport {
  id                String       @id @default(uuid())
  organization_id   String
  organization      Organization @relation(fields: [organization_id], references: [id])
  source_system     String
  file_name         String?
  import_type       String
  status            String
  started_at        DateTime     @default(now())
  completed_at      DateTime?
  records_processed Int          @default(0)
  records_failed    Int          @default(0)
}

// -------------------------------------------------------------------
// RAW STORE
// -------------------------------------------------------------------
model RawRecord {
  id                String   @id
  source_system_id  String
  source_entity_type String
  source_record_id  String
  
  payload           String   // Storing JSON as string to be DB agnostic, but since Postgres could use JsonB
  payload_format    String
  adapter_version   String
  
  ingested_at       DateTime
  batch_id          String
  checksum          String
  
  processing_status String
  error_message     String?
  
  reprocess_count   Int      @default(0)
  last_reprocessed_at DateTime?
  
  @@unique([source_system_id, source_entity_type, source_record_id])
}

// -------------------------------------------------------------------
// MASTER PATIENT INDEX (MPI)
// -------------------------------------------------------------------
model InternalPatientIdentity {
  id                   String   @id // internalPatientId
  status               String   // ACTIVE, MERGED
  
  // Demographics
  given_name_norm      String?
  family_name_norm     String?
  birth_date           String?
  gender               String?
  phone_norm           String?
  
  merged_into          String?
  created_at           DateTime @default(now())
  last_updated_at      DateTime @default(now())

  mpi_identifiers      MpiIdentifier[]
  match_history        MatchHistory[]
}

model MpiIdentifier {
  id                   String   @id @default(uuid())
  identity_id          String
  identity             InternalPatientIdentity @relation(fields: [identity_id], references: [id], onDelete: Cascade)
  value                String
  type                 String
  system               String?
  source_system_id     String?
  is_active            Boolean  @default(true)
  first_seen_at        DateTime @default(now())
}

model MatchHistory {
  id                   String   @id @default(uuid())
  identity_id          String
  identity             InternalPatientIdentity @relation(fields: [identity_id], references: [id], onDelete: Cascade)
  
  matched_identifier   String?
  match_strategy       String
  confidence           Float
  matched_by           String
  decision             String
  details              String?
  
  matched_at           DateTime @default(now())
}

model DuplicateCandidate {
  id                   String   @id
  patient_id_1         String
  patient_id_2         String
  confidence           Float
  status               String
  
  name_score           Float?
  dob_score            Float?
  gender_score         Float?
  phone_score          Float?
  
  flagged_at           DateTime @default(now())
}

// -------------------------------------------------------------------
// TERMINOLOGY
// -------------------------------------------------------------------
model TerminologyConcept {
  id                String   @id
  preferred_term    String
  preferred_term_ar String?
  domain            String
  
  codings           TerminologyCoding[]
}

model TerminologyCoding {
  id                String   @id @default(uuid())
  concept_id        String
  concept           TerminologyConcept @relation(fields: [concept_id], references: [id], onDelete: Cascade)
  system            String
  code              String
  display           String
}

model TerminologyMapping {
  id                   String   @id // mappingId
  source_system_id     String
  source_code          String
  source_display       String?
  canonical_concept_id String
  equivalence          String
  confidence           Float
  rule_version         String
}

// -------------------------------------------------------------------
// PATIENT-REPORTED HEALTH DATA (Patient Self-Service Module)
// -------------------------------------------------------------------

// PatientProfile: Patient-provided profile information and emergency contact
model PatientProfile {
  id                    String    @id @default(uuid())
  patient_id            String    @unique
  patient               Patient   @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  
  // Preferred names and language
  preferred_first_name  String?
  preferred_last_name   String?
  preferred_language    String?   // ISO 639-1: en, ar
  
  // Emergency contact
  emergency_contact_name String?
  emergency_contact_phone String?
  emergency_contact_relationship String?
  
  // Patient-provided address (supplementary)
  address_line          String?
  address_city          String?
  address_district      String?
  address_postal_code   String?
  
  // Metadata
  source                String    @default("PATIENT")
  verification_status   String    @default("SELF_REPORTED") // SELF_REPORTED, VERIFIED
  recorded_at           DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  notes                 String?
  
  created_at            DateTime  @default(now())
}

// PatientReportedAllergy: Patient-entered allergy information
model PatientReportedAllergy {
  id                    String    @id @default(uuid())
  patient_id            String
  patient               Patient   @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  
  // Allergen details
  allergen_name         String    // Original patient-entered text
  allergen_code         String?   // Resolved terminology code if available
  allergen_system       String?   // Terminology system (SNOMED, ICD10, etc)
  allergen_display      String?   // Resolved display text
  
  // Reaction details
  reaction_text         String?
  reaction_severity     String?   // MILD, MODERATE, SEVERE
  
  // Clinical information
  onset_date            DateTime? // Approximate date
  is_medically_diagnosed Boolean?
  notes                 String?
  
  // Metadata
  source                String    @default("PATIENT")
  verification_status   String    @default("UNVERIFIED") // UNVERIFIED, VERIFIED, REFUTED
  recorded_at           DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  
  created_at            DateTime  @default(now())
  
  @@index([patient_id])
}

// PatientReportedMedication: Patient-entered medication information
model PatientReportedMedication {
  id                    String    @id @default(uuid())
  patient_id            String
  patient               Patient   @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  
  // Medication details
  medication_name       String    // Original patient-entered text
  medication_code       String?   // Resolved terminology code if available
  medication_system     String?   // Terminology system
  medication_display    String?   // Resolved display text
  
  // Dosage information
  strength              String?
  dose                  String?
  frequency             String?
  route                 String?
  
  // Clinical information
  reason_for_use        String?
  start_date            DateTime?
  end_date              DateTime?
  currently_taking      Boolean?  @default(true)
  notes                 String?
  
  // Metadata
  source                String    @default("PATIENT")
  verification_status   String    @default("UNVERIFIED") // UNVERIFIED, VERIFIED, REFUTED
  recorded_at           DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  
  created_at            DateTime  @default(now())
  
  @@index([patient_id])
}

// PatientReportedCondition: Patient-reported medical conditions/diagnoses
model PatientReportedCondition {
  id                    String    @id @default(uuid())
  patient_id            String
  patient               Patient   @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  
  // Condition details
  condition_name        String    // Original patient-entered text
  condition_code        String?   // Resolved terminology code if available
  condition_system      String?   // Terminology system
  condition_display     String?   // Resolved display text
  
  // Clinical timeline
  diagnosis_date        DateTime? // Approximate date
  status                String?   // ACTIVE, RESOLVED, RECURRENT
  
  // Additional information
  treating_facility     String?
  notes                 String?
  
  // Metadata
  source                String    @default("PATIENT")
  verification_status   String    @default("UNVERIFIED") // UNVERIFIED, VERIFIED, REFUTED
  recorded_at           DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  
  created_at            DateTime  @default(now())
  
  @@index([patient_id])
}

// PatientReportedProcedure: Patient-reported surgeries and procedures
model PatientReportedProcedure {
  id                    String    @id @default(uuid())
  patient_id            String
  patient               Patient   @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  
  // Procedure details
  procedure_name        String    // Original patient-entered text
  procedure_code        String?   // Resolved terminology code if available
  procedure_system      String?   // Terminology system
  procedure_display     String?   // Resolved display text
  
  // Clinical timeline
  procedure_date        DateTime? // Approximate date
  facility_name         String?
  
  // Additional information
  notes                 String?
  
  // Metadata
  source                String    @default("PATIENT")
  verification_status   String    @default("UNVERIFIED") // UNVERIFIED, VERIFIED, REFUTED
  recorded_at           DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  
  created_at            DateTime  @default(now())
  
  @@index([patient_id])
}

// FamilyMember: Family health history
model FamilyMember {
  id                    String    @id @default(uuid())
  patient_id            String
  patient               Patient   @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  
  // Family relationship
  relative_name         String?
  relationship          String    // MOTHER, FATHER, SIBLING, CHILD, GRANDPARENT, AUNT, UNCLE, COUSIN
  
  // Health information
  condition_name        String?   // Condition affecting this relative
  condition_code        String?   // Resolved terminology code if available
  condition_system      String?   // Terminology system
  condition_display     String?   // Resolved display text
  
  // Timeline
  onset_date            DateTime? // When the relative developed the condition
  
  // Additional information
  notes                 String?
  
  // Metadata
  source                String    @default("PATIENT")
  verification_status   String    @default("UNVERIFIED")
  recorded_at           DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  
  created_at            DateTime  @default(now())
  
  @@index([patient_id])
}

// PatientReportedSocialHistory: Lifestyle and social information
model PatientReportedSocialHistory {
  id                    String    @id @default(uuid())
  patient_id            String    @unique
  patient               Patient   @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  
  // Smoking status
  smoking_status        String?   // NEVER, FORMER, CURRENT
  smoking_frequency     String?   // DAILY, WEEKLY, OCCASIONAL
  
  // Tobacco use
  tobacco_use           String?   // NONE, CHEWING, SNUFF, PIPE, OTHER
  tobacco_frequency     String?
  
  // Physical activity
  physical_activity     String?   // SEDENTARY, LIGHT, MODERATE, VIGOROUS
  activity_notes        String?
  
  // Occupation
  occupation            String?
  
  // Sleep information
  sleep_hours           Int?      // Average hours per night
  sleep_quality         String?   // POOR, FAIR, GOOD, EXCELLENT
  
  // Additional risk factors
  other_risk_factors    String?   // Free text for other relevant information
  
  // Metadata
  source                String    @default("PATIENT")
  verification_status   String    @default("UNVERIFIED")
  recorded_at           DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  
  created_at            DateTime  @default(now())
}

// PatientReportedVitalObservation: Patient-entered home measurements
model PatientReportedVitalObservation {
  id                    String    @id @default(uuid())
  patient_id            String
  patient               Patient   @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  
  // Observation type
  observation_type      String    // BLOOD_PRESSURE, HEART_RATE, TEMPERATURE, WEIGHT, HEIGHT, SPO2, BLOOD_GLUCOSE
  observation_code      String?   // LOINC code if available
  observation_system    String?   // Terminology system
  observation_display   String?   // Display text
  
  // Measurement values
  value_quantity        Float?    // Numeric value
  value_unit            String?   // Unit (mmHg, bpm, C, kg, cm, %, mg/dL, etc)
  value_text            String?   // Free text if numeric not applicable
  
  // For blood pressure specifically
  systolic              Float?
  diastolic             Float?
  
  // Device information (if from device)
  device_name           String?
  device_manufacturer   String?
  device_model          String?
  device_identifier     String?
  
  // Measurement details
  measurement_method    String    // MANUAL_ENTRY, DEVICE, CALCULATED
  recorded_at           DateTime
  measurement_notes     String?
  
  // Metadata
  source                String    @default("PATIENT")
  verification_status   String    @default("UNVERIFIED")
  updated_at            DateTime  @updatedAt
  
  created_at            DateTime  @default(now())
  
  @@index([patient_id])
}

// PatientUploadedDocument: Patient-uploaded medical documents
model PatientUploadedDocument {
  id                    String    @id @default(uuid())
  patient_id            String
  patient               Patient   @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  
  // Document metadata
  filename              String
  file_mimetype         String
  file_size_bytes       Int
  
  // Document classification
  document_category     String    // MEDICAL_REPORT, LAB_REPORT, RADIOLOGY_REPORT, PRESCRIPTION, DISCHARGE_SUMMARY, VACCINATION_CERT, OPERATIVE_REPORT, OTHER
  document_description  String?
  
  // Storage information
  storage_reference     String    // Storage path/reference (not exposed in API)
  
  // Document processing state
  processing_status     String    @default("UPLOADED") // UPLOADED, PROCESSING, EXTRACTED, VERIFICATION_REQUIRED, VERIFIED
  
  // Extracted data (if processing occurred)
  extracted_data        String?   // JSON string with extracted information
  extraction_error      String?   // If extraction failed
  
  // Verification
  verification_status   String    @default("UNVERIFIED") // UNVERIFIED, VERIFIED, REJECTED
  verification_notes    String?
  
  // Metadata
  source                String    @default("PATIENT")
  upload_timestamp      DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  
  created_at            DateTime  @default(now())
  
  @@index([patient_id])
}

