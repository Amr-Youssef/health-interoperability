  hospitalId            String   @id
  hospitalName          String
  hospitalNameAr        String
  facilityType          String
  region                String
  adapterVersion        String
  sourceSchema          String
  defaultMappingConfigs String
  createdAt             String
}

// -------------------------------------------------------------------
// ORGANIZATION CHANGE REQUESTS (Hospital self-service pending MOH approval)
// -------------------------------------------------------------------
model OrganizationChangeRequest {
  id              String   @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  requested_by    String
  requester       User     @relation(fields: [requested_by], references: [id])
  field           String   // organizationName, organizationNameAr, region
  old_value       String?
  new_value       String
  reason          String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewed_by     String?
  reviewer        User?    @relation("Reviewer", fields: [reviewed_by], references: [id])
  reviewed_at     DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([organization_id, status])
  @@index([status])
}

